datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  output        = "../src/generated/client"
}

model UserTasteProfile {
  user_id            String   @id
  top_genres         Json
  preferred_language String
  dominant_cluster   String
  entropy            Float
  loyalty            Float
  computed_at        DateTime @default(now())
  version            Int      @default(1)

  @@map("user_taste_profiles")
}

model CommunityReview {
  id         String   @id @default(uuid())
  user_id    String
  user_name  String
  rating     Int
  comment    String
  created_at DateTime @default(now())

  @@map("community_reviews")
}

model LanguageMapping {
  id       String @id @default(uuid())
  language String // e.g. "Tamil", "Telugu", "Hindi", "Spanish"
  type     String // "genre" or "artist"
  pattern  String // e.g. "kollywood", "anirudh"

  @@map("language_mappings")
}
